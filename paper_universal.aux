\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Interaction Effect on Reaction Time (RT). In the Laboratory (Left), the "Threat" condition caused a significant acceleration in RT (Fight-or-Flight response) compared to Neutral. However, in the Home environment (Right), this effect was completely abolished, showing no significant difference between conditions. Error bars represent Standard Error (SE).}}{6}{}\protected@file@percent }
\newlabel{fig:rt_results}{{4}{6}{}{figure.4}{}}
