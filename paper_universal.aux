\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Data Quality Comparison. The Home environment (Orange) exhibits significantly higher exposure fluctuation ($E_{fluc}$) and lower tracking confidence compared to the Laboratory (Blue), posing a challenge for rPPG signal extraction.}}{6}{}\protected@file@percent }
